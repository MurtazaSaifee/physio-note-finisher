# =============================================================================
# Physio Note Finisher: backend environment
# =============================================================================
# `npm run setup` copies this file to backend/.env. The defaults below run the
# whole app locally with NO API keys and NO cloud services:
#   - Postgres in Docker (docker-compose.yml, host port 5433)
#   - files on local disk instead of S3
#   - voice jobs processed inline instead of through SQS
#   - offline demo speech-to-text and SOAP drafting instead of Sarvam
#   - sign-up / password-reset codes printed to the API console instead of email
# Everything marked "cloud" is only needed for a deployed environment.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# local | staging | production. Staging/production read the secrets below from
# AWS SSM Parameter Store instead of this file.
APP_ENV=local
NODE_ENV=development
PORT=3000
# Set to "true" only behind a trusted reverse proxy (it trusts X-Forwarded-*).
TRUST_PROXY=

# --- Database ------------------------------------------------------------------
DATABASE_URL=postgresql://physio_dev:physio_dev_pass@localhost:5433/physio_note_finisher

# --- Auth ----------------------------------------------------------------------
# Local-only development secrets. Staging/production reject secrets shorter
# than 32 characters or identical to each other; generate real ones with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=local-dev-access-secret-not-for-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-not-for-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=10
# bcrypt cost, 8–15. 12 is a sensible production value.
BCRYPT_COST_FACTOR=12

# --- Demo seed (npm run db:setup) ------------------------------------------------
# Password for the seeded clinician@example.com account. Defaults to password123.
# DEV_CLINICIAN_PASSWORD=

# --- Voice / AI ------------------------------------------------------------------
# Leave SARVAM_API_KEY empty to use the offline demo providers.
# With a key, SOAP and patient-summary drafting use Sarvam (https://www.sarvam.ai).
SARVAM_API_KEY=
VOICE_PROVIDER_DEFAULT=sarvam
VOICE_LLM_DEFAULT_MODEL=sarvam-105b
VOICE_STT_DEFAULT_MODEL=saaras:v3
# Local runtime only. Unset = Spokenly CLI if installed, else the offline stub.
# LOCAL_STT_PROVIDER=stub        # stub | spokenly | sarvam
# Unset = Sarvam when a key is set, else the offline stub.
# LOCAL_LLM_PROVIDER=stub        # stub | sarvam

# --- Storage -------------------------------------------------------------------
# Unset = files under backend/tmp/uploads, served by an authenticated API route.
# LOCAL_STORAGE_DIR=
# Cloud: S3 bucket for recordings and exports.
# S3_REGION=
# S3_BUCKET=

# --- Cloud: queues (SQS) ---------------------------------------------------------
# AWS_REGION=
# SQS_VOICE_QUEUE_URL=
# SQS_CALENDAR_QUEUE_URL=
# SQS_REMINDER_QUEUE_URL=
# SQS_EXPORT_QUEUE_URL=

# --- Optional: Google Calendar sync ----------------------------------------------
# Unset locally = a simulated connection, so the settings screen still works.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=https://api.example.com/auth/google/callback
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Background cleanup of old audio ---------------------------------------------
RETENTION_SCHEDULER_ENABLED=false
RETENTION_SCHEDULER_INTERVAL_MS=3600000
