# Copy to backend/.env for local development.

DATABASE_URL=postgresql://physio_dev:physio_dev_pass@localhost:5432/physio_note_finisher

# Replace these local-only demonstration values before starting the backend.
JWT_ACCESS_SECRET=replace-with-a-random-local-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-local-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_COST_FACTOR=10
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=20
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30

APP_ENV=local
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
DEV_CLINICIAN_PASSWORD=password123
LOCAL_STORAGE_DIR=

# Sarvam is the only external integration. Replace this placeholder with your key.
SARVAM_API_KEY=replace-with-your-sarvam-api-key
VOICE_PROVIDER_DEFAULT=sarvam
VOICE_LLM_DEFAULT_MODEL=sarvam-30b
VOICE_STT_DEFAULT_MODEL=saaras:v3

# Optional local recording-retention cleanup.
RETENTION_SCHEDULER_ENABLED=false
RETENTION_SCHEDULER_INTERVAL_MS=3600000
