# Where the app finds the API. `npm run setup` copies this to mobile/.env.
#
# Android emulator: 10.0.2.2 is the emulator's alias for your computer.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
#
# Physical Android phone over USB: run `adb reverse tcp:3000 tcp:3000`, then use
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
#
# Phone on the same Wi-Fi: use your computer's LAN address, e.g.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000
